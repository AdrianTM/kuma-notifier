{
  "name": "kuma-notifier",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "lint:extension": "web-ext lint --source-dir dist/firefox",
    "source:firefox": "python3 scripts/package-source.py",
    "reviewer:server": "node scripts/reviewer-server.mjs",
    "package": "npm run build && web-ext build --source-dir dist/firefox --artifacts-dir artifacts --overwrite-dest && web-ext build --source-dir dist/chrome --artifacts-dir artifacts/chrome --overwrite-dest"
  },
  "dependencies": {
    "engine.io-client": "6.6.8",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "socket.io": "4.8.1",
    "web-ext": "10.8.0"
  }
}
